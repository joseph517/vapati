# Development image with hot reload (docker-compose.dev.yml). Source is mounted, not copied.
# Java version (same value as Dockerfile). How to update it: docs/arquitectura/06-infraestructura.md
ARG JAVA_VERSION=21.0.12.1_1
FROM eclipse-temurin:${JAVA_VERSION}-jdk-alpine

# bash runs the watcher script; inotify-tools provides inotifywait; curl is used by the healthcheck
RUN apk add --no-cache bash inotify-tools curl

WORKDIR /app

# Maven wrapper and pom.xml for dependency caching
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -B dependency:go-offline

COPY scripts/dev-hot-reload.sh /usr/local/bin/dev-hot-reload.sh
RUN chmod +x /usr/local/bin/dev-hot-reload.sh

EXPOSE 8080 35729
ENV SPRING_PROFILES_ACTIVE=docker,dev
ENV MAVEN_OPTS="-XX:+UseSerialGC -Xmx256m -XX:TieredStopAtLevel=1"
ENV JAVA_OPTS="-XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xss512k -XX:MaxRAMPercentage=50"

CMD ["/usr/local/bin/dev-hot-reload.sh"]
