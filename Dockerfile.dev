# Dockerfile for Development with Hot Reload
# Source code is not copied: docker-compose.dev.yml bind-mounts ./src read-only, and
# scripts/dev-hot-reload.sh compiles it and restarts the app when it changes.
FROM maven:3.9-eclipse-temurin-21

# inotify-tools provides inotifywait, used by the hot reload watcher
RUN apt-get update \
    && apt-get install -y --no-install-recommends inotify-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Maven wrapper and pom.xml for dependency caching
COPY .mvn .mvn
COPY mvnw .
COPY mvnw.cmd .
COPY pom.xml .

RUN chmod +x mvnw mvnw.cmd

# Download dependencies (cached layer)
RUN ./mvnw dependency:go-offline -B

COPY scripts/dev-hot-reload.sh /usr/local/bin/dev-hot-reload.sh
RUN chmod +x /usr/local/bin/dev-hot-reload.sh

# Expose application port and LiveReload port
EXPOSE 8080
EXPOSE 35729

# Set environment variables for development
ENV SPRING_PROFILES_ACTIVE=docker
ENV MAVEN_OPTS="-XX:+TieredCompilation -XX:TieredStopAtLevel=1"

# Starts the app (spring-boot:run with the debug agent on port 5005), watches src/main and pom.xml,
# recompiles on change and triggers the DevTools restart
CMD ["/usr/local/bin/dev-hot-reload.sh"]
