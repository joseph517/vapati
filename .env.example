# Port on which Spring Boot listens inside the app container (server.port)
SERVER_PORT=

# Host port mapped to the app container (docker-compose.yml / docker-compose.dev.yml)
APP_PORT=

# Host port mapped to the SQL Server container (docker-compose.yml / docker-compose.dev.yml)
DB_PORT=

# Password for the SQL Server SA user (MSSQL_SA_PASSWORD / spring.datasource.password).
# Required in production. SQL Server requires a minimum complexity policy (length and character variety).
DB_PASSWORD=

# Secret used to sign/verify JWTs (jwt.secret). Required in production.
JWT_SECRET=

# Comma-separated origins allowed by CORS (cors.allowed-origins).
# Default: http://localhost:4200,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Docker Hub image name to pull in docker-compose.prod.yml (e.g. joseph517/vapati)
IMAGE_NAME=

# Docker Hub image tag to pull in docker-compose.prod.yml (e.g. latest, 1.0.0)
IMAGE_TAG=
