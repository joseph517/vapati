# ---------------------------------------------------------------------------
# Ports — used by docker-compose.yml, docker-compose.dev.yml and docker-compose.prod.yml
# ---------------------------------------------------------------------------

# Port on which Spring Boot listens inside the app container (server.port)
SERVER_PORT=

# Host port mapped to the app container
APP_PORT=

# Host port mapped to the SQL Server container
DB_PORT=

# ---------------------------------------------------------------------------
# Secrets — used by all three compose files. Required in production; in
# development they only need to be non-empty (any value works).
# ---------------------------------------------------------------------------

# Password for the SQL Server SA user (MSSQL_SA_PASSWORD / spring.datasource.password).
# SQL Server requires a minimum complexity policy (length and character variety).
DB_PASSWORD=

# Secret used to sign/verify JWTs (jwt.secret). REQUIRED in every environment:
# at least 32 bytes, random, and not the old placeholder. Without it the app doesn't start.
# Generate it with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Comma-separated origins allowed by CORS (cors.allowed-origins).
# Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Production image — only used by docker-compose.prod.yml
# ---------------------------------------------------------------------------

# Docker Hub image name to pull (e.g. joseph517/vapati)
IMAGE_NAME=

# Docker Hub image tag to pull (e.g. latest, 1.0.0)
IMAGE_TAG=
