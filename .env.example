# Puerto en el que escucha Spring Boot dentro del contenedor de la app (server.port)
SERVER_PORT=8080

# Puerto de host mapeado al contenedor de la app (docker-compose.yml / docker-compose.dev.yml)
APP_PORT=8080

# Puerto de host mapeado al contenedor de SQL Server (docker-compose.yml / docker-compose.dev.yml)
DB_PORT=1433
